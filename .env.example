# Public site URL used for canonical, sitemap, OG images
NEXT_PUBLIC_SITE_URL=https://eshaanarya.com

# GitHub — public API powers the Projects section (auto-sync).
# Optional token to raise rate limits (recommended on Vercel).
GITHUB_USERNAME=earya1999
GITHUB_TOKEN=

# Shared secret for POST /api/revalidate (manual refresh or GitHub webhook).
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# Contact form endpoint (Resend, Formspree, or a custom API).
# Leave blank to fall back to a mailto: link.
CONTACT_FORM_ENDPOINT=

# Optional analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
